# Copy this file to .env and fill in your values.
# .env is gitignored — your secrets stay local.

READWISE_TOKEN=your_token_here
XLSX_PATH=/path/to/your/highlights.xlsx
OBSIDIAN_QUOTES_DIR=/path/to/obsidian/quotes
OBSIDIAN_STAGING_DIR=/path/to/obsidian/staging
QUOTES_TEMPLATE_PATH=/path/to/template.md
